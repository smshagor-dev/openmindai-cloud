# Private Laravel backend target, not the public developer API base URL.
# Never prefix with NEXT_PUBLIC_.
LARAVEL_API_URL=https://cloud.openmindai.org/api/v1
# Public HTTPS origin of the new Next.js portal. Shown Base URL = PORTAL_ORIGIN + /api/v1/openmindai.
PORTAL_ORIGIN=http://localhost:3100
# Configure this on the server, not in a browser or committed file.
NODE_ENV=development
# Only enable behind ingress that overwrites and validates real client IP headers.
TRUST_PROXY_HEADERS=false
