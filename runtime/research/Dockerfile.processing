FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends pandoc lmodern texlive-fonts-recommended texlive-xetex texlive-lang-arabic fonts-noto-core fonts-noto-cjk fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
COPY runtime/research/requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt
COPY runtime/research /opt/openmind/runtime/research
COPY frontend/public/research-csl /opt/openmind/frontend/public/research-csl
COPY docs/RESEARCH_THIRD_PARTY_NOTICES.md /opt/openmind/RESEARCH_THIRD_PARTY_NOTICES.md
USER 65534:65534
ENV HOME=/tmp
WORKDIR /tmp
CMD ["python","-I","/opt/openmind/runtime/research/cli.py"]
