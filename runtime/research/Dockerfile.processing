FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends pandoc texlive-xetex texlive-lang-arabic fonts-noto-core fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
COPY runtime/research/requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt
COPY runtime/research /opt/openmind/runtime/research
USER 65534:65534
ENV HOME=/tmp
WORKDIR /tmp
CMD ["python","-I","/opt/openmind/runtime/research/cli.py"]
