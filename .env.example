APP_NAME="Openmindai"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://models.example.com
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=online_model
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
INFERENCE_URL=http://127.0.0.1:8080/v1
INFERENCE_KEY=
# NVIDIA key for backend image jobs and the chat provider gateway.
# Image-generation requests never include this key in Next.js or browser payloads.
NVIDIA_API_KEY=
HF_TOKEN=
MODEL_MAX_BYTES=10000000000
MODEL_STORAGE_BUDGET_BYTES=50000000000
# Daily requests per user; internal research calls do not consume extra requests.
CHAT_DAILY_LIMIT=200
TASK_DAILY_LIMIT=20
# Queue reservation retention for long research jobs.
QUEUE_RETRY_AFTER=86400

# Optional Next.js frontend origin for password reset emails.
FRONTEND_URL=
# Comma-separated Next.js proxy IPs, only when its ingress headers are trusted.
TRUSTED_PROXIES=

# Optional own SearXNG JSON endpoint, e.g. http://127.0.0.1:8888/search
SEARXNG_SEARCH_URL=

# Private self-hosted Hugging Face media runtime (disabled until configured)
MEDIA_RUNTIME_URL=
MEDIA_RUNTIME_KEY=
MEDIA_ENABLED_KINDS=
IMAGE_DAILY_LIMIT=20
MEDIA_DAILY_LIMIT=20
MEDIA_USER_STORAGE_BYTES=200000000

# Shared only with the Next.js server for authenticated hosted-chat persistence.
FRONTEND_CHAT_BRIDGE_KEY=

# Operator-reviewed MCP HTTPS endpoints. Bearer credentials are stored per user, encrypted.
MCP_SERVERS_JSON='{}'
MCP_DAILY_LIMIT=100
# Warm private transcription/vision endpoint for continuous voice and camera sessions.
MEDIA_LIVE_ENABLED=false
LIVE_DAILY_LIMIT=20

# First administrator: set explicitly before running the seeder; no default login password.
ADMIN_NAME="Openmindai Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional local PNG/JPEG/WebP <= 512x512 and 96 KB.
ADMIN_AVATAR_PATH=

# Public developer API Base URL (the Next.js portal, never Laravel).
DEVELOPER_API_BASE_URL=

# Try public Bing RSS and DuckDuckGo search if SearXNG is unavailable.
PUBLIC_SEARCH_FALLBACK=true

# Laravel image generation: queue worker required (queue=media). The public
# NVIDIA FLUX.2 Klein generation uses explicit dimensions for each aspect ratio.
CLOUD_IMAGE_ENABLED=true
# Provider response wait in seconds, bounded to 30–720 by the worker.
CLOUD_IMAGE_TIMEOUT=720
CLOUD_IMAGE_PROMPT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional private HTTPS NIM supporting arbitrary user uploads (not NVIDIA preview).
# Set only on Laravel, never in NEXT_PUBLIC_ or Next.js frontend variables.
CLOUD_IMAGE_EDIT_NIM_URL=
CLOUD_IMAGE_EDIT_NIM_KEY=
CLOUD_IMAGE_EDIT_MODEL=qwen/qwen-image-edit-2511
# Optional private mask-aware runtime. Must accept mode, image and PNG mask.
CLOUD_IMAGE_MASK_NIM_URL=
CLOUD_IMAGE_MASK_NIM_KEY=
CLOUD_IMAGE_MASK_MODEL=

# Research Studio: configure privately on the application and isolated broker.
# Models must already have successful provider verification and be enabled.
RESEARCH_MODEL=nvidia-nemotron-3-ultra-550b-a55b
RESEARCH_FALLBACK_MODELS=openmindai-ultra
RESEARCH_EMBEDDING_MODEL=
RESEARCH_TOKEN_BUDGET=500000
RESEARCH_WORKER_URL=
RESEARCH_WORKER_KEY=
RESEARCH_CONTACT_EMAIL=
OPENALEX_API_KEY=

# Optional server-only search APIs. Public fallbacks remain available.
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Python interpreter with runtime/web-reader/requirements.txt installed.
WEB_RESEARCH_PYTHON_BINARY=python3

# Private 3D worker origin and dedicated signing key. Never expose to browsers.
STUDIO_WORKER_URL=
STUDIO_WORKER_KEY=
STUDIO_SCENE_EXECUTION=direct
STUDIO_QUEUE_ENABLED=false
